# Copy to /etc/homeworks/env on the host. Chmod 0640, owned by root:homeworks.
APPLICATIONS_ADMIN_TOKEN=replace-me-with-a-strong-random-token
APPLICATIONS_IP_SALT=replace-me-with-a-32-byte-random-string
NETS_CORS_ORIGINS=https://YOUR-DOMAIN
HOMEWORKS_DB_PATH=/opt/homeworks/var/homeworks.db
# Add provider keys here only if AI features are needed:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

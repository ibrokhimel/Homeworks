# AI backend — at least one of these must be configured.
# Priority order: Vertex AI > Gemini API key > Kimi (Moonshot).

# --- Vertex AI (preferred) ---
# Absolute path to service account JSON key.
VERTEX_CREDENTIALS_PATH=C:/Users/DaddysHere/Documents/claw_api_service.json
# Optional overrides (project_id is auto-read from JSON if not set here)
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# --- Gemini API key (fallback 1) ---
GEMINI_API_KEY=

# --- Kimi / Moonshot (fallback 2) ---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# --- Server ---
PORT=8000
DEBUG=true

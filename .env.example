# AI backend — Kimi (Moonshot) is the sole provider.
# AI_BACKEND_PREFERENCE is kept for forward compat; currently only "kimi" is registered.
AI_BACKEND_PREFERENCE=kimi

# --- Kimi / Moonshot ---
# Note: defaults switched from kimi-k2-turbo-preview (pre-F0 historical) to
# the moonshot-v1-* series. Override via KIMI_MODEL_FAST / KIMI_MODEL_PRO if
# you have access to k2-turbo or want to pin a different model.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL_FAST=moonshot-v1-32k
KIMI_MODEL_PRO=moonshot-v1-128k

# --- Server ---
PORT=8000
DEBUG=true
